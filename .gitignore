# Python and build artifacts
__pycache__/
*.pyc
*.egg-info/
.venv/
.venv-*/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Benchmark datasets and model caches are external inputs.
data/
models/
endpoints.json

# Run outputs
artifacts/
results/
logs/
